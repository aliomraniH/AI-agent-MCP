  "description": "Agent Coordinator MCP server for multi-agent coordination via action logging, resource locking, and state synchronization",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
